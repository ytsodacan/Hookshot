<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 is part of Windows 10 (1903 and later) and Windows 11, so the app is a few hundred KB and nothing is
       downloaded or installed to run it (a self-contained .NET 8 build was ~70 MB to download, a bad deal on a slow connection, and a framework-dependent one needs the
       .NET 8 Desktop Runtime installed). The Windows download is a thin launcher: Python and llvm-mingw are installed separately. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HookshotBuilder</AssemblyName>
    <RootNamespace>HookshotBuilder</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Hookshot Builder</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon Condition="Exists('..\..\work\hookshot.ico')">..\..\work\hookshot.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- all of these are part of the .NET Framework itself: no extra files beside the exe -->
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
